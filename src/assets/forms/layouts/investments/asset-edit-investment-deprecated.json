            }
          ]
        }
      },
      {
        "type": "visible",
        "field": "contributionsStartDate",
        "value": true,
        "condition": {
          "operator": "AND",
          "condition": [
            {
              "type": "=",
              "field": "contributionsBool",
              "value": true
            }
          ]
        }
      },
      {
        "type": "visible",
        "field": "contributionsEndDate",
        "value": true,
        "condition": {
          "operator": "AND",
          "condition": [
            {
              "type": "=",
              "field": "contributionsBool",
              "value": true
            }
          ]
        }
      },
      {
        "type": "visible",
        "field": "contributionsAmount",
        "value": true,
        "condition": {
          "operator": "AND",
          "condition": [
            {
              "type": "=",
              "field": "contributionsBool",
              "value": true
            }
          ]
        }
      },
      {
        "type": "visible",
        "field": "contributionsFrequency",
        "value": true,
        "condition": {
          "operator": "AND",
          "condition": [
            {
              "type": "=",
              "field": "contributionsBool",
              "value": true
            }
          ]
        }
      },
      {
        "type": "visible",
        "field": "amountAsAt",
        "value": true,
        "condition": {
          "operator": "AND",
          "condition": [
            {
              "type": "=",
              "field": "contributionsBool",
              "value": true
            }
          ]
        }
      },
      {
